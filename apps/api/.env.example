# Copy to .env and fill in. `npm run dev` works without MONGODB_URI: it starts a local
# MongoDB in apps/api/.data. Set MONGODB_URI (e.g. a MongoDB Atlas string) to use a real one.
PORT=4100
MONGODB_URI=

# Long random string used to sign login tokens. Required in production, 32+ characters.
JWT_SECRET=

# Website address(es) allowed to call the API, comma-separated
CORS_ORIGIN=http://localhost:5180

# The one admin account, created on first start. Changing these and restarting updates it.
# Required in production; the local defaults are admin@hapivet.com / hapivet123.
ADMIN_EMAIL=admin@hapivet.com
ADMIN_PASSWORD=

# Customer sign-in code. No SMS provider yet, so every number uses this code.
FIXED_OTP=123456

# Fill an empty database with sample leads. Website content is always filled on first start.
# Defaults to true locally and false in production.
SEED_SAMPLE_LEADS=
